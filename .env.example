# ── Required ──────────────────────────────────────────────────────────────────
# The webhook URL for your primary Microsoft Teams channel
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR_WEBHOOK_URL_HERE
# Your National Vulnerability Database API key
NVD_API_KEY=your-nvd-api-key-here

# ── Schedule & Timezone ────────────────────────────────────────────────────────
# e.g., Asia/Kolkata, America/New_York, UTC
TZ=Asia/Kolkata

# ── Alert Thresholds ───────────────────────────────────────────────────────────
# Options: LOW, MEDIUM, HIGH, CRITICAL
MIN_ALERT_SEVERITY=LOW
# Number of consecutive fetcher failures before alerting the channel
FAILURE_ALERT_THRESHOLD=3

# ── Data Retention ─────────────────────────────────────────────────────────────
# Automatically delete findings older than this many days (e.g., 30, 90, 365)
RETENTION_DAYS=90
# Days to retain internal application logs (e.g., 7, 30)
LOG_RETENTION_DAYS=30

# ── Weekly Digest ──────────────────────────────────────────────────────────────
# Options: Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday
WEEKLY_DIGEST_DAY=Monday
# WEEKLY_DIGEST_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR_DIGEST_WEBHOOK

# ── Optional Escalation Channel ───────────────────────────────────────────────
# Posts HIGH/CRITICAL findings to a separate channel, independently of the daily batch.
# CRITICAL_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR_CRITICAL_WEBHOOK

# ── Optional: GitHub Advisory integration ─────────────────────────────────────
# GITHUB_TOKEN=ghp_your_token_here

# ── Authentication (Microsoft Entra ID) ────────────────────────────────────────
# ENTRA_CLIENT_ID=your-client-id
# ENTRA_CLIENT_SECRET=your-client-secret
# ENTRA_TENANT_ID=your-tenant-id
# BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
